{
  "project": {
    "name": "SolosUniapp",
    "type": "starter-template",
    "status": "ready",
    "stack": [
      "uni-app",
      "vue3",
      "typescript",
      "vite",
      "unocss"
    ],
    "platforms": [
      "h5",
      "mp-weixin"
    ],
    "ui_library": "wot-design-uni",
    "request_library": "alova",
    "features": [
      "home-playground",
      "chart"
    ],
    "auto_import": true
  },
  "entrypoints": {
    "app": "src/main.ts",
    "page_home": "src/pages/index.vue",
    "layout": "src/layouts/default.vue",
    "request": [
      "src/core/request/alova.ts",
      "src/core/request/http.ts"
    ],
    "config": [
      "vite.config.ts",
      "pages.config.ts",
      "manifest.config.ts",
      "config/targets.ts",
      "config/targets-resolver.ts"
    ],
    "examples": [
      "src/features/playground/store.ts",
      "src/features/demo-auth/service.ts",
      "src/features/example-items/service.ts",
      "src/pages/examples/index.vue"
    ]
  },
  "commands": {
    "install": "pnpm i",
    "dev": [
      "pnpm dev:h5",
      "pnpm dev:mp-weixin"
    ],
    "check": [
      "pnpm check"
    ],
    "test": [
      "pnpm test:unit",
      "pnpm test:e2e",
      "pnpm test:mp:smoke",
      "pnpm test"
    ],
    "build": [
      "pnpm build",
      "pnpm build:h5",
      "pnpm build:mp-weixin"
    ],
    "upload": [
      "pnpm upload:mp"
    ]
  },
  "env": {
    "examples": [
      "env/.env.example",
      "env/.env.wechat.example"
    ],
    "required_base": [
      "VITE_API_HOST",
      "VITE_API_PATH",
      "VITE_UPLOAD_HOST",
      "VITE_UPLOAD_PATH"
    ],
    "required_mp_weixin": [
      "VITE_APPID_WEIXIN",
      "VITE_PROJECT_NAME_WEIXIN"
    ],
    "upload_secrets_weixin": [
      "WX_PRIVATE_KEY_PATH_WEIXIN",
      "WX_PRIVATE_KEY_WEIXIN_BASE64",
      "WX_PRIVATE_KEY_WEIXIN"
    ]
  },
  "workflows": [
    ".github/workflows/mini-build.yml",
    ".github/workflows/upload-weixin.yml",
    ".github/workflows/upload-all-mini.yml"
  ],
  "references": [
    "AGENTS.md",
    "README.md",
    "TESTING_POLICY.md"
  ],
  "last_updated": "2026-10-30"
}
